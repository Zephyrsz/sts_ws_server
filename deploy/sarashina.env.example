SARASHINA_TTS_MODEL_PATH=/app/sts_ws_server/models/tts/sarashina2.2-tts
SARASHINA_TTS_DEVICE=cuda:0
SARASHINA_REFERENCE_AUDIO=
SARASHINA_REFERENCE_TEXT=
SARASHINA_VOICE_PROFILES=/app/sts_ws_server/deploy/sarashina-voices.example.json
SARASHINA_MAX_TOKENS=2048
SARASHINA_MAX_TEXT_CHARS=10000
SARASHINA_AUDIO_CHUNK_BYTES=4096
# Digital output gain applied before PCM16 conversion. Set to 0 to disable.
SARASHINA_GAIN_DB=3.0
