[Unit]
Description=Ornith Chat Completions WebSocket bridge
After=network-online.target llama-server.service
Wants=network-online.target
Requires=llama-server.service

[Service]
Type=simple
User=roger
Group=roger
WorkingDirectory=/app/sts_ws_server
EnvironmentFile=/app/sts_ws_server/ornith.env
Environment=PYTHONPATH=/app/sts_ws_server/src
ExecStart=/app/sts_ws_server/venv/bin/uvicorn sts_ws_server.llm_wss:app --host 127.0.0.1 --port 18444 --ssl-certfile /app/sts_ws_server/tls/llm-wss.crt --ssl-keyfile /app/sts_ws_server/tls/llm-wss.key --ws-max-size 4194304
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
