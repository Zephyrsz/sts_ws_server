[Unit]
Description=Qwen3-TTS WebSocket adapter
Requires=qwen3-tts-vllm.service
After=qwen3-tts-vllm.service

[Service]
Type=simple
User=roger
Group=roger
WorkingDirectory=/app/sts_ws_server/service-src
EnvironmentFile=/app/sts_ws_server/wss.env
Environment=SERVICE_NAME=qwen-tts
Environment=QWEN_TTS_BACKEND=openai
Environment=QWEN_TTS_BASE_URL=http://127.0.0.1:8091/v1
Environment=QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
Environment=QWEN_TTS_VOICE=aiden
Environment=MAX_CONCURRENT_REQUESTS=1
Environment=MODEL_TIMEOUT_SECONDS=300
ExecStart=/app/sts_ws_server/venv/bin/uvicorn sts_ws_server.app:app --host 127.0.0.1 --port 18100 --workers 1
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
