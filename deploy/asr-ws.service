[Unit]
Description=ASR WebSocket service with Silero VAD and Qwen3-ASR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roger
Group=roger
LogsDirectory=sts-ws-server
LogsDirectoryMode=0750
ReadWritePaths=/var/log/sts-ws-server
WorkingDirectory=/app/sts_ws_server/asr-service
EnvironmentFile=/etc/sts-ws-server/asr.env
Environment=WSS_LOG_FILE=/var/log/sts-ws-server/asr-ws.log
Environment=WSS_LOG_BACKUP_COUNT=14
Environment=HOME=/tmp
Environment=HF_HOME=/tmp/sts-ws-hf
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=PYTHONPATH=/app/sts_ws_server/asr-service/src
ExecStart=/app/sts_ws_server/venv-qwen3-asr/bin/python -m uvicorn sts_ws_server.app:app --host 127.0.0.1 --port 8011 --workers 1 --ws-max-size 4194304
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
