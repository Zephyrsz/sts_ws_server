SERVICE_NAME=asr
WSS_API_KEY=replace-with-a-long-random-token

ASR_BACKEND=kotoba
ASR_MODEL=/app/sts_ws_server/models/asr/kotoba
ASR_DEVICE=cuda:0

VAD_BACKEND=silero
VAD_MODEL_PATH=/app/sts_ws_server/models/vad/silero/silero_vad.onnx
VAD_THRESHOLD=0.5
VAD_ONNX_PROVIDER=CPUExecutionProvider
VAD_FRAME_MS=32
VAD_PADDING_MS=120

MAX_AUDIO_SECONDS=120
MAX_CONCURRENT_REQUESTS=1
