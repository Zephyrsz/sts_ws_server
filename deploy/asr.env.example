SERVICE_NAME=asr
WSS_API_KEY=replace-with-a-long-random-token

ASR_BACKEND=qwen3
ASR_MODEL=/app/sts_ws_server/models/asr/qwen3-asr-1.7b
ASR_DEVICE=cuda:4
ASR_COMPUTE_TYPE=bfloat16
ASR_MAX_NEW_TOKENS=256

VAD_BACKEND=energy
VAD_MODEL_PATH=/app/sts_ws_server/models/vad/silero/silero_vad.onnx
VAD_RMS_THRESHOLD=450
VAD_FRAME_MS=20
VAD_PADDING_MS=120

MAX_AUDIO_SECONDS=120
MAX_CONCURRENT_REQUESTS=1
