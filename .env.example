# Generate a long random value before exposing the gateway.
WSS_API_KEY=replace-with-a-long-random-token

# ASR can run in this container or call an OpenAI-compatible transcription API.
ASR_BACKEND=faster-whisper
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BASE_URL=http://host.docker.internal:8090/v1
ASR_API_KEY=
ASR_HTTP_MODEL=whisper-1

# Each TTS adapter has its own model endpoint and model identifier.
QWEN_TTS_BACKEND=openai
QWEN_TTS_BASE_URL=http://host.docker.internal:8091/v1
QWEN_TTS_API_KEY=
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_TTS_VOICE=aiden
QWEN_TTS_SAMPLE_RATE=24000

COSYVOICE_TTS_BACKEND=openai
COSYVOICE_TTS_BASE_URL=http://host.docker.internal:8092/v1
COSYVOICE_TTS_API_KEY=
COSYVOICE_TTS_MODEL=cosyvoice3
COSYVOICE_TTS_VOICE=default
COSYVOICE_TTS_SAMPLE_RATE=24000

MAX_AUDIO_SECONDS=120
MAX_TEXT_CHARS=10000
MAX_CONCURRENT_REQUESTS=2
VAD_RMS_THRESHOLD=450
VAD_FRAME_MS=20
VAD_PADDING_MS=120
TTS_AUDIO_CHUNK_BYTES=4096
MODEL_TIMEOUT_SECONDS=300

# Directory containing tls.crt and tls.key.
TLS_DIR=./tls
